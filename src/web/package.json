{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
