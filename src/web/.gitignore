# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/tests-e2e-results
/tests-e2e/.playwright-output
/playwright-report
/blob-report
# Visual regression baselines under tests-e2e/__screenshots__ are
# committed deliberately (they are the regression baseline, generated by
# the pinned Docker image in the VisualRegression CI job) — never ignore
# that directory.

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
