# Copy this file to .env.local and fill in real values for local
# development. .env.local is gitignored - never commit real secrets.
# See src/web/AGENTS.md and infrastructure/AGENTS.md for the
# authoritative rationale behind each of these.

# A real local Postgres 16 instance. There is no persistent shared
# local dev database in this project - npm run dev's own predev
# script (scripts/ensure-local-postgres.mjs) starts an ephemeral
# Docker container matching this exact URL, enables citext, and runs
# npm run db:migrate automatically, every time. The manual steps below
# are what that script does under the hood - only needed directly for
# troubleshooting or if Docker isn't available and a different real
# Postgres is used instead:
#   docker run --name devafusion-dev-local -e POSTGRES_PASSWORD=localdev -p 5432:5432 -d postgres:16
#   docker exec devafusion-dev-local psql -U postgres -c "CREATE EXTENSION IF NOT EXISTS citext;"
#   npm run db:migrate
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/postgres

# Better Auth's own session-signing secret. Any sufficiently random
# string works for local dev; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Without this, Better Auth derives the origin from each incoming
# request and warns loudly on every request - set it explicitly for
# local dev to silence the warning and get correct redirect/callback
# behaviour.
BETTER_AUTH_URL=http://localhost:3000

# encrypted-column-cipher.ts's AES-256-GCM key - must decode to
# exactly 32 raw bytes once base64-decoded, or every TOTP
# enrolment/decrypt call throws. Generate a correctly-sized key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# form-timing-token.ts's HMAC key - any sufficiently random string
# works for local dev; not a real production secret's shape
# requirement, just needs to be present.
FORM_TIMING_TOKEN_SECRET=

# Cloudflare's own documented "always passes" dummy Turnstile
# sitekey/secretkey pair - safe to commit, not a real secret
# (playwright.config.ts's webServer.env already uses the same pair).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional - leave unset to disable GA4 locally (google-analytics.tsx's
# own runtime check treats an unset/falsy value as "analytics
# disabled"). Never send real local dev traffic to the real GA4
# property.
# NEXT_PUBLIC_GA_ID=

# Optional - only needed if testing absolute-URL generation locally.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
