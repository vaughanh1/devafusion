root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

[*.tf]
indent_size = 2

[*.ps1]
indent_size = 4
